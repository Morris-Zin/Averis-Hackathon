# Local development. Never commit .env or real credentials.
AVERIS_ENV=development
AVERIS_DATABASE_URL=postgresql+psycopg://averis:averis@localhost:5432/averis
AVERIS_ORIGIN=http://localhost:8000
AVERIS_STORAGE_BACKEND=local
AVERIS_STORAGE_DIR=.local/documents
AVERIS_FRONTEND_DIR=apps/web/out
AVERIS_OPERATOR_TOKEN=

# Remain disabled until starting usage and provider prices are verified.
AVERIS_LIVE_ENABLED=false
AVERIS_BUDGET_VERIFIED=false
AVERIS_PRIOR_SPEND_USD=0
AVERIS_INPUT_USD_PER_MILLION=0
AVERIS_OUTPUT_USD_PER_MILLION=0
AVERIS_JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
AVERIS_DEEPSEEK_FIELDS_ENABLED=false
DEEPSEEK_API_KEY=

# Production storage and authenticated task delivery (server only).
AVERIS_R2_ENDPOINT=
AVERIS_R2_BUCKET=
AVERIS_R2_ACCESS_KEY_ID=
AVERIS_R2_SECRET_ACCESS_KEY=
AVERIS_TASKS_QUEUE=
AVERIS_WORKER_URL=
AVERIS_TASKS_SERVICE_ACCOUNT=

# Tests require an isolated PostgreSQL database where temporary schemas are allowed.
AVERIS_TEST_DATABASE_URL=
